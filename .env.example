# Solana Arbitrage Bot Configuration

# ============================================================================
# شبكة Solana
# ============================================================================

# رابط RPC الأساسي (Mainnet)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# رابط WebSocket للاتصال المباشر
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com

# المفتاح الخاص للمحفظة (Base58 مشفّر)
# احذر: لا تشاركه مع أحد أبداً!
# يمكنك الحصول عليه من: Phantom, Solflare, أو أي محفظة أخرى
SOLANA_PRIVATE_KEY=

# ============================================================================
# إعدادات المراجحة والأرباح
# ============================================================================

# الحد الأدنى للربح المطلوب (بوحدة SOL)
# البوت لن ينفذ صفقة إلا إذا كان الربح أكبر من هذه القيمة
MIN_PROFIT_THRESHOLD=0.001

# الحد الأقصى للانزلاق المسموح به (نسبة مئوية)
# إذا تجاوز الانزلاق هذه القيمة، سيتم إلغاء الصفقة
MAX_SLIPPAGE_TOLERANCE=2.0

# الحد الأقصى لسعر الغاز (lamports)
# تجنب الصفقات عند ارتفاع أسعار الغاز
MAX_GAS_PRICE=10000

# الحد الأقصى لرسم Flash Loan المسموح به (نسبة مئوية)
FLASH_LOAN_MAX_FEE=0.1

# ============================================================================
# إعدادات المراقبة والأداء
# ============================================================================

# فترة تحديث أسعار المجمعات (بالميلي ثانية)
# مثال: 5000 = تحديث كل 5 ثوان
POOL_UPDATE_INTERVAL=5000

# حجم نافذة التتبع (عدد الكتل)
# البوت سيتتبع آخر N كتلة للبحث عن فرص المراجحة
BACKRUN_WINDOW_SIZE=10

# الانتظار لتأكيد الكتلة قبل تنفيذ الصفقة
# true = انتظر التأكيد | false = أرسل فوراً
EXECUTE_ON_BLOCK_CONFIRMATION=true

# ============================================================================
# إعدادات الإنتاج
# ============================================================================

# تفعيل وضع التصحيح (Debug Mode)
DEBUG=false

# وضع المحاكاة - اختبر الصفقات بدون تنفيذ فعلي
SIMULATION_MODE=false

# ============================================================================
# ملاحظات مهمة
# ============================================================================

# 1. تأكد من إدخال SOLANA_PRIVATE_KEY بشكل صحيح
# 2. ابدأ برصيد صغير للاختبار أولاً
# 3. راقب السجلات (logs) لفهم تحركات البوت
# 4. استخدم testnet في البداية قبل mainnet
# 5. لا تترك البوت يعمل دون مراقبة
